# Barrel Terminal — environment variables
# Copy to `.env` and fill in real values (NEVER commit the filled .env).
# On Fly.io these are stored as `flyctl secrets set` (see REPRODUCTION.md §6).

# --- Auth / bridge ---
APP_PASSWORD=change-me-strong-password          # browser login gate
LIVE_INGEST_TOKEN=change-me-random-32-chars     # must match bridge_config.json ingest_token

# --- EIA (US gov petroleum) --- has a working default in code; override if you have your own
EIA_API_KEY=

# --- Platts / SPGCI (api.platts.com) ---
SPGCI_USERNAME=
SPGCI_PASSWORD=

# --- Kpler ---
KPLER_USERNAME=
KPLER_PASSWORD=

# --- Genscape / Wood Mackenzie (api.genscape.com) ---
GSPE_API_KEY=
GSPE_EU_API_KEY=

# --- IIR / Industrial Info (api.industrialinfo.com) --- has defaults in code
IIR_USERNAME=
IIR_PASSWORD=

# --- Azure SQL (optional; set USE_AZURE_SQL=1 to enable) ---
USE_AZURE_SQL=0
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_SCHEMA=COA

# --- LLM market commentary (optional) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# MARKET_LLM_MODEL=gpt-4o-mini
# MARKET_LLM_MODEL_ANTHROPIC=claude-3-5-sonnet-20241022
